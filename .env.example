# FraudShield AI Environment Configuration (Template)

# Database Connection
# SQLite (out-of-the-box local sandbox):
DATABASE_URL=sqlite:///./fraudshield.db

# PostgreSQL Connection (Production / Local PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fraudshield

# Backend Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Live Telemetry Simulation
ENABLE_LIVE_SIMULATOR=true
SIMULATION_INTERVAL_SECONDS=4
