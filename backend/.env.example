# FraudShield AI Backend Environment Configuration

# Database Configuration
# Default fallback to SQLite if PostgreSQL is not configured:
DATABASE_URL=sqlite:///./fraudshield.db

# To use PostgreSQL, set your connection string:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fraudshield

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation & Live Stream
SIMULATION_INTERVAL_SECONDS=4
ENABLE_LIVE_SIMULATOR=true
